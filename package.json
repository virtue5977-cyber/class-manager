{
  "name": "class-manager",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "build:single": "tsc -b && SINGLE=1 vite build && node -e \"require('fs').renameSync('dist-single/index.html','dist-single/담임업무.html')\"",
    "dist:folder": "npm run build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.8.10",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.9"
  },
  "main": "electron/main.cjs",
  "description": "Watson — 담임 업무(출결·결석신고서·상담일지·학급)",
  "author": "class-manager",
  "build": {
    "appId": "kr.classmanager.app",
    "productName": "Watson",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "담임업무_${version}_포터블.exe"
    }
  }
}
